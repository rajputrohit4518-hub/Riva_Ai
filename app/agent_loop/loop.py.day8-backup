from app.agent_loop.decision import DecisionMaker
from app.agent_loop.models import DecisionType
from app.core.session import RivaSession
from app.orchestration.models import OrchestrationResult
from app.orchestration.orchestrator import RivaOrchestrator
from app.planner.executor import PlanExecutor
from app.planner.planner import RivaPlanner
from app.verification.correction import SelfCorrector


class RivaAgentLoop:
    MAX_STEPS = 10

    def __init__(
        self,
        orchestrator: RivaOrchestrator,
        decision_maker: DecisionMaker | None = None,
        planner: RivaPlanner | None = None,
        corrector: SelfCorrector | None = None,
    ) -> None:
        self._orchestrator = orchestrator
        self._decision = decision_maker or DecisionMaker()

        self._planner = planner or RivaPlanner()

        if corrector is None:
            self._corrector = SelfCorrector(
                PlanExecutor(
                    self._orchestrator.execution_engine
                )
            )
        else:
            self._corrector = corrector

    def run(
        self,
        session: RivaSession,
        user_input: str,
    ) -> OrchestrationResult:

        orchestration = self._orchestrator.prepare(
            session=session,
            user_input=user_input,
        )

        multi_step = getattr(
            self._decision,
            "supports_multi_step",
            False,
        )

        for _ in range(self.MAX_STEPS):
            if getattr(
                self._decision,
                "supports_context",
                False,
            ):
                decision = self._decision.decide(
                    user_input,
                    orchestration.context,
                )
            else:
                decision = self._decision.decide(
                    user_input
                )

            if decision.decision_type == DecisionType.RESPOND:
                result = self._orchestrator.respond(
                    orchestration,
                    decision.response or "",
                )

                if result.response:
                    session.last_response = result.response

                return result

            if decision.decision_type == DecisionType.USE_TOOL:
                plan = self._planner.create_plan(
                    user_input
                )

                correction = self._corrector.run(plan)

                if not correction.success:
                    result = self._orchestrator.respond(
                        orchestration,
                        (
                            "I couldn't complete that action: "
                            f"{correction.error}"
                        ),
                    )

                    if result.response:
                        session.last_response = result.response

                    return result

                if not correction.outputs:
                    result = self._orchestrator.respond(
                        orchestration,
                        "The action completed without a result.",
                    )

                    if result.response:
                        session.last_response = result.response

                    return result

                final_output = correction.outputs[-1]

                result = self._orchestrator.respond(
                    orchestration,
                    final_output,
                )

                if result.response:
                    session.last_response = result.response

                if not multi_step:
                    return result

                return result

            raise RuntimeError(
                f"Unsupported decision: "
                f"{decision.decision_type}"
            )

        result = self._orchestrator.respond(
            orchestration,
            "I reached the maximum number of steps for this request.",
        )

        if result.response:
            session.last_response = result.response

        return result
